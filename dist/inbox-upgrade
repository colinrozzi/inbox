#!/usr/bin/env bash
# inbox-upgrade — install/update the `inbox` CLI from the latest GitHub Release
# of colinrozzi/inbox. Mirrors the fleet's supervisor-upgrade wrapper: drop a
# static binary on PATH, no container rebuild, no theater/wasm, no result-symlink.
#
#   inbox-upgrade                    # install/update to the latest inbox-cli release
#   inbox-upgrade inbox-cli-v0.1.0   # pin a specific tag
#
# NOTE: the `inbox` CLI now ships WITH every server release (`release-*`) as an
# `inbox` + `SHA256SUMS` asset pair, so the CLI can never skew from the server it
# talks to. "latest" here means the newest release carrying an `inbox` asset. The
# old standalone `inbox-cli-v*` series is RETIRED — pass such a tag explicitly if
# you need to fetch an old one.
set -euo pipefail

REPO="colinrozzi/inbox"
TAG="${1:-latest}"
BIN_DIR="${INBOX_BIN_DIR:-$HOME/.local/bin}"
SHARE_DIR="${INBOX_SHARE_DIR:-$HOME/.local/share/inbox}"
mkdir -p "$BIN_DIR" "$SHARE_DIR"

# Prefer gh (agents are gh-authed); fall back to curl against the release API.
if command -v gh >/dev/null 2>&1; then
  if [ "$TAG" = "latest" ]; then
    # Newest release carrying an `inbox` asset (the CLI now ships with release-*).
    TAG=$(gh api "repos/$REPO/releases" --paginate \
            --jq '[.[] | select(any(.assets[]?; .name == "inbox")) | .tag_name] | .[0]')
    [ -n "$TAG" ] && [ "$TAG" != "null" ] \
      || { echo "inbox-upgrade: no release with an 'inbox' asset found on $REPO"; exit 1; }
  fi
  echo "inbox-upgrade: fetching $REPO@$TAG …"
  gh release download "$TAG" --repo "$REPO" --clobber --dir "$SHARE_DIR" \
     --pattern 'inbox' --pattern 'SHA256SUMS'
else
  if [ "$TAG" = "latest" ]; then
    # Newest release carrying an `inbox` asset, via the public releases API (no auth).
    TAG=$(curl -fSL "https://api.github.com/repos/$REPO/releases" \
            | jq -r '[.[] | select(any(.assets[]?; .name == "inbox")) | .tag_name] | .[0]')
    [ -n "$TAG" ] && [ "$TAG" != "null" ] \
      || { echo "inbox-upgrade: no release with an 'inbox' asset found on $REPO"; exit 1; }
  fi
  echo "inbox-upgrade: fetching $REPO@$TAG …"
  base="https://github.com/$REPO/releases/download/$TAG"
  curl -fSL "$base/inbox"        -o "$SHARE_DIR/inbox"
  curl -fSL "$base/SHA256SUMS"   -o "$SHARE_DIR/SHA256SUMS" || true
fi

# Integrity: verify the binary against the published checksums before installing.
if [ -f "$SHARE_DIR/SHA256SUMS" ]; then
  ( cd "$SHARE_DIR" && sha256sum -c --ignore-missing SHA256SUMS ) \
    || { echo "inbox-upgrade: checksum verification FAILED — refusing to install"; exit 1; }
else
  echo "inbox-upgrade: WARNING no SHA256SUMS found — skipping integrity check"
fi

install -m 0755 "$SHARE_DIR/inbox" "$BIN_DIR/inbox"
echo "inbox-upgrade: installed $TAG -> $BIN_DIR/inbox"
"$BIN_DIR/inbox" --help >/dev/null 2>&1 \
  && echo "inbox-upgrade: ok (a static HTTPS client — set INBOX_TOKEN or ~/.config/inbox/token, INBOX_API defaults to mail.colinrozzi.com:443)"
